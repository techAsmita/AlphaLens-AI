# Copy this file to .env and adjust values as needed.
# All keys are optional; sensible defaults are baked into app/utils/config.py.

APP_NAME="AlphaLens AI API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

LOG_LEVEL=INFO

# Data pipeline providers. "mock" uses canned data with no external
# calls. Set to a real provider name once one is implemented in the
# corresponding service module (transcript_service.py / news_service.py).
TRANSCRIPT_PROVIDER=mock
NEWS_PROVIDER=mock

# Required only for gemini_service.generate_report(). Leave unset to
# run the app without Gemini — everything else works fine without it.
GEMINI_API_KEY=
